JWT_EXPIRACAO="15m"
JWT_REFRESH_SEGREDO="ChaveSecretaParaJWTRefresh"
JWT_REFRESH_EXPIRACAO="7d"

# E-mail (SMTP Local - Mailpit)
SMTP_HOST="localhost"

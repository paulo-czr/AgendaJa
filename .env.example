# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://agendaja:agendaja_dev_password@localhost:5432/agendaja_db"

# Servidor (NestJS)
PORTA_SERVIDOR=3000
URL_APLICATIVO="http://localhost:5173"

# Autenticação (JWT via HTTP-Only Cookies)
JWT_SEGREDO="ChaveSecretaParaJWT"
JWT_EXPIRACAO="15m"
JWT_REFRESH_SEGREDO="ChaveSecretaParaJWTRefresh"
JWT_REFRESH_EXPIRACAO="7d"

# E-mail (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORTA=587
SMTP_SEGURO="false"
SMTP_USUARIO="seu-email@gmail.com"
SMTP_SENHA="sua-senha-de-app"
SMTP_REMETENTE="AgendaJá <seu-email@gmail.com>"

# Frontend (Vite / React)
VITE_API_URL="http://localhost:3000"